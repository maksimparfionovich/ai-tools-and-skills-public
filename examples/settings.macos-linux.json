{
  "env": { "MCP_TIMEOUT": "240000" },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash|PowerShell",
        "hooks": [{ "type": "command",
                    "command": "python3 \"${CLAUDE_PROJECT_DIR}/tools/deploy-guard/guard.py\"",
                    "timeout": 15 }] }
    ],
    "PostToolUse": [
      { "matcher": "Write|Edit|MultiEdit",
        "hooks": [{ "type": "command",
                    "command": "python3 \"${CLAUDE_PROJECT_DIR}/tools/qa-report-lint/lint.py\" --hook",
                    "timeout": 20 }] }
    ]
  }
}
