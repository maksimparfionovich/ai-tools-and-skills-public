# Used by `npm run smoke` (scripts/smoke-test.ts). The MCP server itself takes the
# same variables from the MCP client config (env block). Copy to .env and fill in.

# --- Target CMS ---
# OPTIONAL. Usually the stand is chosen in chat via cms_set_target. Set this only
# if you want a starting stand. No trailing slash.
# Examples:
#   https://cms-qa1.example.com
#   http://localhost:3000
CMS_BASE_URL=

# --- Credentials: a test user of the stand (not your personal account) ---
CMS_EMAIL=
CMS_PASSWORD=

# Optional: TOTP secret (base32). Only needed if the account has 2FA enabled.
CMS_TOTP_SECRET=

# --- Write guard (see README, "Защита от записи") ---
# Writes are allowed on localhost and on hosts listed here. Comma-separated;
# `cms-qa*.example.com` (* = anything but a dot) and `*.example.com` (domain and
# all subdomains) are supported.
CMS_ALLOW_WRITE_HOSTS=
# Always read-only, wins over everything else: prod, UAT, anything on the prod DB.
CMS_READONLY_HOSTS=

# --- Login (stock Payload works with the defaults) ---
# Auth collection slug, used for /api/<slug>/login and /api/<slug>/me.
CMS_USERS_COLLECTION=users
# Custom login endpoint. Empty: try /api/auth/login, fall back to /api/<slug>/login on 404.
CMS_LOGIN_PATH=

# --- Defaults ---
# Locales of the CMS, comma-separated (reported by cms_list_locales).
CMS_LOCALES=
# Default locale used when a tool call does not specify one.
CMS_DEFAULT_LOCALE=en
# Default relationship depth for read operations.
CMS_DEFAULT_DEPTH=1
# Request timeout in milliseconds.
CMS_TIMEOUT_MS=30000

# Optional outbound HTTP(S) proxy (corporate / QA networks). Usually empty.
# Falls back to standard HTTPS_PROXY / HTTP_PROXY env vars if not set here.
CMS_HTTPS_PROXY=

# --- Schema sync (optional) ---
# Path to src/payload-types.ts in your CMS repo clone, used by
# `npm run sync-schema` and the cms_schema_doctor tool.
#   macOS / Linux: CMS_PAYLOAD_TYPES_PATH=/path/to/my-cms/src/payload-types.ts
#   Windows:       CMS_PAYLOAD_TYPES_PATH=C:/path/to/my-cms/src/payload-types.ts
CMS_PAYLOAD_TYPES_PATH=
