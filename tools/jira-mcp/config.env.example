# Настройки туннеля Teleport к Jira. Скопируйте в config.env рядом со скриптами.
# config.env в git не идёт. Переменные окружения сильнее этого файла.

# Адрес Teleport-прокси (то, что передаётся в tsh login --proxy=...)
TELEPORT_PROXY="${TELEPORT_PROXY:-teleport.example.com}"
# Имя приложения Jira в Teleport (tsh apps ls)
JIRA_APP="${JIRA_APP:-jira}"

# Необязательно:
# JIRA_PORT=8080              # локальный порт туннеля
# JIRA_HEALTH_PATH=/status    # что опрашивать, чтобы понять, что Jira отвечает
# JIRA_TUNNEL_LOGIN=1         # 0 — не открывать браузер для tsh login, только сообщить в лог
# JIRA_MCP_PYTHON=python3     # интерпретатор с установленным mcp-atlassian
